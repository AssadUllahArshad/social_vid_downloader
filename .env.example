NEXT_PUBLIC_SITE_URL=https://socialviddownloader.com
API_INTERNAL_URL=http://127.0.0.1:8000
DATABASE_URL=postgresql+psycopg://socialvid:localdevelopment@localhost:5432/socialvid
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development
RATE_LIMIT_PER_MINUTE=20
IP_HASH_SECRET=replace-with-a-long-random-value
POSTGRES_PASSWORD=localdevelopment
# Reserved for later phases; no analytics currently load.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
SENTRY_DSN=
# Local development defaults to SQLite so the API works without a local Redis daemon.
STATE_BACKEND=sqlite
LOCAL_STATE_PATH=/tmp/socialvid-state.sqlite
MEDIA_ROOT=/tmp/socialvid-media
METADATA_CACHE_TTL_SECONDS=120
EXTRACT_TIMEOUT_SECONDS=90
DOWNLOAD_TIMEOUT_SECONDS=180
MAX_DURATION_SECONDS=1800
MAX_FILE_BYTES=209715200
MAX_STORAGE_BYTES=1073741824
MAX_CONCURRENT_JOBS=2
SESSION_TTL_SECONDS=600
FILE_TTL_SECONDS=600
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
TRUSTED_PROXY_IPS=127.0.0.1,::1
# Read-only provider administration; unset disables the internal endpoint.
ADMIN_PROVIDER_TOKEN=
# Production only: require a random IP_HASH_SECRET (>=32 chars), PostgreSQL,
# non-development DB credentials, and Redis. API starts fail-closed otherwise.
# Set at build time after HTTPS works; leave disabled for local HTTP.
ENABLE_HSTS=0
# Set ONLY when a private trusted ingress overwrites this header on every request.
# Typical nginx: X-Real-IP. Keep empty if the frontend is directly reachable.
TRUSTED_CLIENT_IP_HEADER=
# Monitoring/tracking variables above remain optional reserved configuration.
# This release does not load analytics or send events to Sentry.
# Explicit API host allowlist (no scheme or ports); API container hostname is api.
ALLOWED_HOSTS=socialviddownloader.com,127.0.0.1,localhost,api
CORS_ORIGINS=https://socialviddownloader.com
# Verified file-processing tools. Set to 0 to disable upload processing.
PROCESSING_ENABLED=1

# Same-origin processing upload cap; never above 200 MiB.
PROCESSING_MAX_UPLOAD_BYTES=209715200
