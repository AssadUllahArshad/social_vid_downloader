# Docker Compose production example. Copy to root .env; chmod 600 .env.
# Generate TWO independent values with: openssl rand -hex 32
# Blank required secrets make Compose fail closed. Do not use dev credentials.
POSTGRES_PASSWORD=
IP_HASH_SECRET=
ENVIRONMENT=production
STATE_BACKEND=redis
NEXT_PUBLIC_SITE_URL=https://socialviddownloader.com
# Compose fixes API_INTERNAL_URL=http://api:8000 and REDIS_URL=redis://redis:6379/0,
# and constructs DATABASE_URL from POSTGRES_PASSWORD. These are not host overrides.
ENABLE_HSTS=0
ALLOWED_HOSTS=socialviddownloader.com,127.0.0.1,localhost,api
CORS_ORIGINS=https://socialviddownloader.com
# Use with deploy/compose.ingress.yml; Nginx MUST overwrite X-Real-IP.
TRUSTED_CLIENT_IP_HEADER=X-Real-IP
TRUSTED_PROXY_IPS=172.30.90.10
ADMIN_PROVIDER_TOKEN=
PROCESSING_ENABLED=1
PROCESSING_MAX_UPLOAD_BYTES=209715200
MAX_FILE_BYTES=209715200
MAX_STORAGE_BYTES=1073741824
MAX_DURATION_SECONDS=1800
MAX_CONCURRENT_JOBS=2
RATE_LIMIT_PER_MINUTE=20
EXTRACT_TIMEOUT_SECONDS=90
DOWNLOAD_TIMEOUT_SECONDS=180
SESSION_TTL_SECONDS=600
FILE_TTL_SECONDS=600
METADATA_CACHE_TTL_SECONDS=120
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# MEDIA_ROOT is fixed to the private media-data volume by Compose.
# Optional analytics/Sentry remain inactive; no credentials are needed.
